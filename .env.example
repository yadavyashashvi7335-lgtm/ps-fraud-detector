# Backend settings
APP_NAME=PS Fraud Detector Backend
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Model artefacts
BASELINE_MODEL_DIR=app/models/artefacts
TRANSFORMER_MODEL_DIR=app/models/artefacts/transformer

# Default explanation language (en | hi)
DEFAULT_LANG=hi

# Scoring thresholds
SAFE_THRESHOLD=0.30
SCAM_THRESHOLD=0.70

# Model weight blend
ML_WEIGHT=0.55
RULE_WEIGHT=0.45

# LLM explanation (optional - OpenAI compatible)
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Google Gemini AI help (optional - for AI assistant chat)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
