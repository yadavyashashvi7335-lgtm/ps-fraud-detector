# Backend settings
APP_NAME=PS Fraud Detector Backend
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Model artefacts
BASELINE_MODEL_DIR=app/models/artefacts
TRANSFORMER_MODEL_DIR=app/models/artefacts/transformer

# Default explanation language (en | hi)
DEFAULT_LANG=hi

# LLM explanation (optional). Works without this using rule-based fallback templates.
# Set LLM_BASE_URL to any OpenAI-compatible endpoint (OpenAI, Groq, Ollama, etc.)
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
